# Environment Configuration Template for DevSupport Backend
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/devsupport?replicaSet=rs0
MONGODB_AUTO_INDEX=true
JWT_ACCESS_SECRET=your-minimum-32-character-secret-key-for-256bit-hs256
JWT_ISSUER=DevSupport-API
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX=5
LOG_LEVEL=info
